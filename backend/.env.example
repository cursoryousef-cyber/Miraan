# ============================================================================
# مِران (Miran) — Environment Variables Example
# National Health Training Management Platform
# ============================================================================

# Application Settings
NODE_ENV=production
PORT=10000
# `api`, not `api/v1` — URI versioning appends the v1 segment itself.
API_PREFIX=api
SWAGGER_ENABLED=true
CORS_ORIGIN=*

# PostgreSQL Database Connection (Neon / Render / AWS RDS)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# JWT Authentication Secrets & Expirations
JWT_ACCESS_SECRET=your-production-jwt-access-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# File Storage Provider (local, s3, azure_blob, supabase)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=miran-production-uploads
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Platform Owner Initial Bootstrap Credentials
PLATFORM_OWNER_EMAIL=admin@miran.health
PLATFORM_OWNER_PASSWORD=<set-per-environment>
PLATFORM_OWNER_NAME_AR=مدير المنصة
PLATFORM_OWNER_NAME_EN=Platform Owner

# Base URL of the deployed web frontend. Required in production — activation and
# password-reset links fall back to http://localhost:5173 when unset.
FRONTEND_URL="https://<your-frontend-domain>"

# Initial passwords for the production seed (src/seed/seed-production.ts).
# One per account; the seed aborts before writing anything if any is missing or
# shorter than 8 characters. Existing passwords are never overwritten unless
# SEED_OVERWRITE_PASSWORDS=true is set explicitly.
SEED_PASSWORD_PLATFORM_OWNER=<set-per-environment>
SEED_PASSWORD_CLUSTER_MANAGER=<set-per-environment>
SEED_PASSWORD_ORG_MANAGER=<set-per-environment>
SEED_PASSWORD_ACADEMIC_MANAGER=<set-per-environment>
SEED_PASSWORD_UNI_SUPERVISOR=<set-per-environment>
SEED_PASSWORD_UNIVERSITY_ADMINISTRATOR=<set-per-environment>
SEED_PASSWORD_HOSPITAL_ADMINISTRATOR=<set-per-environment>
SEED_PASSWORD_HOSPITAL_TRAINING_ADMIN=<set-per-environment>
SEED_PASSWORD_TRAINER=<set-per-environment>
SEED_PASSWORD_TRAINEE_ABDULLAH=<set-per-environment>
SEED_PASSWORD_TRAINEE_FATIMA=<set-per-environment>
SEED_PASSWORD_TRAINEE_KHALID=<set-per-environment>
SEED_PASSWORD_TRAINEE_SARA=<set-per-environment>
SEED_PASSWORD_TRAINEE_FAISAL=<set-per-environment>

# Rate Limiting & Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# HMAC Secret for Digital Trainee ID Cards
CARD_HMAC_SECRET=your-production-card-hmac-secret-key
