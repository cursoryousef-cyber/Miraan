/// طاقة استيعابية دقيقة يحدّدها المستشفى نفسه — لا يجوز للتجمع تعديلها مباشرة.
/// scopeId/specialtyCode/gender/trainingPeriod تستخدم '' (وليس NULL) كقيمة
/// "أي/غير محدد" حتى يعمل قيد @@unique بشكل صحيح (Postgres يعامل NULL كقيم
/// متمايزة دائماً، فلا يمنع التكرار لو كانت هذه الحقول nullable).
model CapacityAllocation {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  /// 'hospital' | 'department' | 'specialty' | 'trainer' | 'supervisor' | 'program'
  scopeType         String       @map("scope_type") @db.VarChar(20)
  /// معرف القسم/المدرب/المشرف حسب scopeType، أو '' لسعة المستشفى الكلية
  scopeId           String       @default("") @map("scope_id") @db.VarChar(64)
  /// رمز التخصص من LookupTable، أو '' لعدم التقييد بتخصص
  specialtyCode     String       @default("") @map("specialty_code") @db.VarChar(100)
  /// 'male' | 'female' أو '' لعدم التقييد بالجنس
  gender            String       @default("") @db.VarChar(10)
  /// فترة التدريب (عادة academicYear الدفعة)، أو '' لعدم التقييد بفترة
  trainingPeriod    String       @default("") @map("training_period") @db.VarChar(50)
  totalCapacity     Int          @default(0) @map("total_capacity")
  notes             String?
  createdById       String?      @map("created_by") @db.Uuid
  updatedById       String?      @map("updated_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// نهاية فترة التدريب
  trainingEndDate   DateTime?    @map("training_end_date") @db.Date
  /// بداية فترة التدريب — لربط السعة بفترات زمنية محددة
  trainingStartDate DateTime?    @map("training_start_date") @db.Date
  /// معرف البرنامج التدريبي من الكتالوج الوطني، أو '' لعدم التقييد ببرنامج.
  /// يُستخدم مع scopeType='program' لسعة البرنامج في المستشفى، ومع
  /// scopeType='department'/'trainer' لتقسيم مقاعد البرنامج على الأقسام والمدربين.
  /// نص وليس مفتاحاً خارجياً — اتساقاً مع scopeId ولتفادي دلالات NULL في قيد التفرد.
  programId         String       @default("") @map("program_id") @db.VarChar(64)
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, scopeType, scopeId, programId, specialtyCode, gender, trainingPeriod], map: "capacity_allocations_org_scope_program_key")
  @@index([organizationId, scopeType])
  @@index([organizationId, programId])
  @@index([trainingStartDate, trainingEndDate])
  @@map("capacity_allocations")
}

/// سجل تخصيص المتدرب — المصدر الرسمي الوحيد لتاريخ التوزيع.
///
/// قبل هذا الجدول كان التخصيص أعمدة مسطّحة على training_request_trainees
/// (assigned_hospital_id / assigned_department_id / assigned_trainer_profile_id)
/// تُكتب فوق بعضها. إعادة التوزيع كانت تمحو ما قبلها، فلا يمكن إثبات أن تخصيصاً
/// قديماً أُغلق وآخر جديداً فُتح — وهي بالضبط الحقيقة التي يحتاجها الـTimeline
/// والتدقيق. هنا كل تغيير صف جديد، والقديم يُعلَّم superseded ولا يُحذف أبداً.
///
/// ثابت أساسي: لكل متدرب صف واحد فقط بحالة open في أي لحظة.
model TraineeAllocation {
  id                    String                  @id @default(uuid()) @db.Uuid
  traineeRowId          String                  @map("trainee_row_id") @db.Uuid
  traineeProfileId      String?                 @map("trainee_profile_id") @db.Uuid
  academicIntakeId      String?                 @map("academic_intake_id") @db.Uuid
  trainingRequestId     String?                 @map("training_request_id") @db.Uuid
  /// التجمع صاحب قرار التوزيع — يُستخدم لفلترة النطاق دون تتبع الطلب.
  clusterOrgId          String                  @map("cluster_org_id") @db.Uuid
  hospitalId            String                  @map("hospital_id") @db.Uuid
  departmentId          String?                 @map("department_id") @db.Uuid
  trainerProfileId      String?                 @map("trainer_profile_id") @db.Uuid
  supervisorAccountId   String?                 @map("supervisor_account_id") @db.Uuid
  /// الحالة السابقة الكاملة — تُنسخ عند الإغلاق ليقرأ الـTimeline الانتقال
  /// (من أين ← إلى أين) من صف واحد دون ضم.
  previousAllocationId  String?                 @unique @map("previous_allocation_id") @db.Uuid
  previousHospitalId    String?                 @map("previous_hospital_id") @db.Uuid
  previousDepartmentId  String?                 @map("previous_department_id") @db.Uuid
  previousTrainerId     String?                 @map("previous_trainer_id") @db.Uuid
  /// open | superseded | closed | cancelled
  status                String                  @default("open") @db.VarChar(20)
  /// auto | manual | cluster_reassign | hospital_reassign | hospital_assign
  action                String                  @db.VarChar(30)
  reason                String?
  startDate             DateTime?               @map("start_date") @db.Date
  endDate               DateTime?               @map("end_date") @db.Date
  performedById         String?                 @map("performed_by") @db.Uuid
  performedAt           DateTime                @default(now()) @map("performed_at") @db.Timestamptz(6)
  closedById            String?                 @map("closed_by") @db.Uuid
  closedAt              DateTime?               @map("closed_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  traineeRow            TrainingRequestTrainee  @relation(fields: [traineeRowId], references: [id])
  academicIntake        AcademicIntake?         @relation(fields: [academicIntakeId], references: [id])
  trainingRequest       TrainingRequest?        @relation(fields: [trainingRequestId], references: [id])
  cluster               Organization            @relation("AllocationCluster", fields: [clusterOrgId], references: [id])
  hospital              Organization            @relation("AllocationHospital", fields: [hospitalId], references: [id])
  department            Department?             @relation(fields: [departmentId], references: [id])
  trainerProfile        TrainerProfile?         @relation(fields: [trainerProfileId], references: [id])
  performedBy           UserAccount?            @relation("AllocationPerformer", fields: [performedById], references: [id])
  previousAllocation    TraineeAllocation?      @relation("AllocationChain", fields: [previousAllocationId], references: [id])
  nextAllocation        TraineeAllocation?      @relation("AllocationChain")

  @@index([traineeRowId, status])
  @@index([hospitalId, status])
  @@index([clusterOrgId, status])
  @@index([academicIntakeId])
  @@map("trainee_allocations")
}

/// تأهيل المدرب للبرامج التدريبية — علاقة متعدد إلى متعدد
/// المدرب لا يشرف إلا على البرامج المُسندة إليه (قيد صارم في محرك التوزيع).
model TrainerProgram {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainerProfileId String         @map("trainer_profile_id") @db.Uuid
  programId        String         @map("program_id") @db.Uuid
  /// سعة المدرب ضمن هذا البرنامج تحديداً — إن تُركت فارغة تُستخدم سعة المدرب العامة
  maxTrainees      Int?           @map("max_trainees")
  isActive         Boolean        @default(true) @map("is_active")
  createdById      String?        @map("created_by") @db.Uuid
  updatedById      String?        @map("updated_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  program          Program        @relation(fields: [programId], references: [id])
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, programId])
  @@index([programId])
  @@map("trainer_programs")
}

