  code                    String?                   @db.VarChar(50)
  capacity                Int                       @default(10)
  description             String?
  roundLocation           String?                   @map("round_location") @db.VarChar(200)
  roundTime               String?                   @map("round_time") @db.VarChar(50)
  meetingRoom             String?                   @map("meeting_room") @db.VarChar(100)
  mapUrl                  String?                   @map("map_url") @db.VarChar(500)
  contactExtension        String?                   @map("contact_extension") @db.VarChar(20)
  firstDayExpectations    String?                   @map("first_day_expectations")
  settings                Json                      @default("{}")
  isActive                Boolean                   @default(true) @map("is_active")
  createdById             String?                   @map("created_by") @db.Uuid
  updatedById             String?                   @map("updated_by") @db.Uuid
  deletedById             String?                   @map("deleted_by") @db.Uuid
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
