  isActive       Boolean                 @default(true) @map("is_active")
  isMandatory    Boolean                 @default(true) @map("is_mandatory")
  createdById    String?                 @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptances    DeclarationAcceptance[]
  organization   Organization            @relation(fields: [organizationId], references: [id])

  @@map("declarations")
}

/// سجلات الموافقة والتوقيع الرقمي للإقرارات
model DeclarationAcceptance {
  id             String       @id @default(uuid()) @db.Uuid
  declarationId  String       @map("declaration_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  version        Int
  acceptedAt     DateTime     @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress      String?      @map("ip_address") @db.VarChar(50)
  deviceInfo     String?      @map("device_info") @db.VarChar(300)
  declaration    Declaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           UserAccount  @relation(fields: [userId], references: [id])

  @@unique([declarationId, userId, version])
  @@map("declaration_acceptances")
}

/// مكتبة الإجراءات والمهارات السريرية
model ProcedureCatalog {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique @db.VarChar(50)
  titleAr       String               @map("title_ar") @db.VarChar(300)
  titleEn       String               @map("title_en") @db.VarChar(300)
  category      String               @db.VarChar(100)
  minRequired   Int                  @default(5) @map("min_required")
  descriptionAr String?              @map("description_ar")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  caseLogs      ClinicalCaseLog[]
  competencies  CompetencyProgress[]

  @@map("procedure_catalogs")
}

/// سجل الحالة والحالة السريرية للمتدرب (Clinical Case & Procedure Log)
model ClinicalCaseLog {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  traineeProfileId   String            @map("trainee_profile_id") @db.Uuid
  trainerProfileId   String?           @map("trainer_profile_id") @db.Uuid
  rotationId         String?           @map("rotation_id") @db.Uuid
  departmentId       String?           @map("department_id") @db.Uuid
  procedureId        String?           @map("procedure_id") @db.Uuid
  diagnosis          String            @db.VarChar(300)
  patientAge         Int?              @map("patient_age")
  patientGender      String?           @map("patient_gender") @db.VarChar(20)
  specialtyAr        String?           @map("specialty_ar") @db.VarChar(200)
  complexity         String            @default("medium") @db.VarChar(20)
  participationLevel String            @default("performed") @map("participation_level") @db.VarChar(50)
  notes              String?
  evidenceUrls       String[]          @default([]) @map("evidence_urls")
  status             String            @default("submitted") @db.VarChar(30)
  performedAt        DateTime          @default(now()) @map("performed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  department         Department?       @relation(fields: [departmentId], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id])
  procedure          ProcedureCatalog? @relation(fields: [procedureId], references: [id])
  rotation           Rotation?         @relation(fields: [rotationId], references: [id])
  traineeProfile     TraineeProfile    @relation(fields: [traineeProfileId], references: [id])
  trainerProfile     TrainerProfile?   @relation(fields: [trainerProfileId], references: [id])
  signoffs           LogbookSignoff[]

  @@index([traineeProfileId])
  @@index([organizationId])
  @@map("clinical_case_logs")
}

/// كفاءات المتدرب ومتابعة التقدم بالمهارات (Competency Tracking)
model CompetencyProgress {
  id               String           @id @default(uuid()) @db.Uuid
  traineeProfileId String           @map("trainee_profile_id") @db.Uuid
  procedureId      String           @map("procedure_id") @db.Uuid
  requiredCount    Int              @default(5) @map("required_count")
  completedCount   Int              @default(0) @map("completed_count")
  status           String           @default("pending") @db.VarChar(20)
  lastUpdated      DateTime         @default(now()) @map("last_updated") @db.Timestamptz(6)
  procedure        ProcedureCatalog @relation(fields: [procedureId], references: [id])
  traineeProfile   TraineeProfile   @relation(fields: [traineeProfileId], references: [id])

  @@unique([traineeProfileId, procedureId])
  @@map("competency_progress")
}

/// التوقيع والاعتماد الرقمي للحالة / السجل (Digital Sign-off)
model LogbookSignoff {
  id           String          @id @default(uuid()) @db.Uuid
  caseLogId    String          @map("case_log_id") @db.Uuid
  signerId     String          @map("signer_id") @db.Uuid
  signerRole   String          @map("signer_role") @db.VarChar(30)
  signatureUrl String?         @map("signature_url") @db.VarChar(500)
  feedback     String?
  signedAt     DateTime        @default(now()) @map("signed_at") @db.Timestamptz(6)
  caseLog      ClinicalCaseLog @relation(fields: [caseLogId], references: [id], onDelete: Cascade)
  signer       UserAccount     @relation(fields: [signerId], references: [id])

  @@map("logbook_signoffs")
}

/// إجازات المدربين وتغطياتهم — لضمان استمرار تدريب المتدربين دون انقطاع
model TrainerLeave {
  id                   String                @id @default(uuid()) @db.Uuid
  trainerProfileId     String                @map("trainer_profile_id") @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  /// annual_leave | emergency_leave | sick_leave | maternity_leave
  /// training_course | conference | temporary_assignment
  /// transfer | retirement | resignation
  leaveType            String                @map("leave_type") @db.VarChar(30)
  startDate            DateTime              @map("start_date") @db.Date
  endDate              DateTime              @map("end_date") @db.Date
  /// pending | approved | active | completed | cancelled
  status               String                @default("pending") @db.VarChar(20)
  reason               String?
  replacementTrainerId String?               @map("replacement_trainer_id") @db.Uuid
  autoReassigned       Boolean               @default(false) @map("auto_reassigned")
  approvedById         String?               @map("approved_by") @db.Uuid
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(6)
  createdById          String?               @map("created_by") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization          @relation(fields: [organizationId], references: [id])
  replacementTrainer   TrainerProfile?       @relation("ReplacementLeaves", fields: [replacementTrainerId], references: [id])
  trainerProfile       TrainerProfile        @relation("TrainerLeaves", fields: [trainerProfileId], references: [id])
  reassignments        TrainerReassignment[]

  @@index([trainerProfileId, status])
  @@index([organizationId, startDate])
  @@map("trainer_leaves")
}

/// سجل إعادة الإسناد — immutable audit trail لنقل المتدربين بين المدربين
model TrainerReassignment {
  id                    String                       @id @default(uuid()) @db.Uuid
  organizationId        String                       @map("organization_id") @db.Uuid
  /// single | multiple | entire_trainer | entire_department
  reassignmentType      String                       @map("reassignment_type") @db.VarChar(30)
  /// annual_leave | emergency_leave | sick_leave | maternity_leave
  /// training_course | conference | temporary_assignment | transfer
  /// retirement | resignation | capacity_overflow | department_closure
  /// administrative_decision
  reason                String                       @db.VarChar(50)
  previousTrainerId     String                       @map("previous_trainer_id") @db.Uuid
  newTrainerId          String                       @map("new_trainer_id") @db.Uuid
  departmentId          String                       @map("department_id") @db.Uuid
  trainerLeaveId        String?                      @map("trainer_leave_id") @db.Uuid
  effectiveDate         DateTime                     @map("effective_date") @db.Timestamptz(6)
  previousAssignmentEnd DateTime?                    @map("previous_assignment_end") @db.Timestamptz(6)
  notes                 String?
  approvedById          String?                      @map("approved_by") @db.Uuid
  createdById           String                       @map("created_by") @db.Uuid
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  trainees              TrainerReassignmentTrainee[]
  department            Department                   @relation(fields: [departmentId], references: [id])
  newTrainer            TrainerProfile               @relation("ReassignmentTo", fields: [newTrainerId], references: [id])
  organization          Organization                 @relation(fields: [organizationId], references: [id])
  previousTrainer       TrainerProfile               @relation("ReassignmentFrom", fields: [previousTrainerId], references: [id])
  trainerLeave          TrainerLeave?                @relation(fields: [trainerLeaveId], references: [id])

  @@index([organizationId, createdAt])
  @@index([previousTrainerId])
  @@index([newTrainerId])
  @@map("trainer_reassignments")
}

/// تفصيل المتدربين المنقولين في كل عملية إعادة إسناد
model TrainerReassignmentTrainee {
  id                String              @id @default(uuid()) @db.Uuid
  reassignmentId    String              @map("reassignment_id") @db.Uuid
  traineeProfileId  String              @map("trainee_profile_id") @db.Uuid
  rotationId        String              @map("rotation_id") @db.Uuid
  previousTrainerId String              @map("previous_trainer_id") @db.Uuid
  newTrainerId      String              @map("new_trainer_id") @db.Uuid
  reassignment      TrainerReassignment @relation(fields: [reassignmentId], references: [id], onDelete: Cascade)
  rotation          Rotation            @relation(fields: [rotationId], references: [id])
  traineeProfile    TraineeProfile      @relation(fields: [traineeProfileId], references: [id])

  @@index([reassignmentId])
  @@map("trainer_reassignment_trainees")
}

/// الخطة والجدول التدريبي — الإطار التنظيمي العام للجدول
model TrainingSchedule {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  departmentId     String?               @map("department_id") @db.Uuid
  titleAr          String                @map("title_ar") @db.VarChar(300)
  titleEn          String?               @map("title_en") @db.VarChar(300)
  startDate        DateTime              @map("start_date") @db.Date
  endDate          DateTime              @map("end_date") @db.Date
  status           String                @default("draft") @db.VarChar(20) // draft | review | approved | published | locked | archived
  totalHours       Int                   @default(0) @map("total_hours")
  notes            String?
  createdById      String?               @map("created_by") @db.Uuid
  updatedById      String?               @map("updated_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization          @relation(fields: [organizationId], references: [id])
  department       Department?           @relation(fields: [departmentId], references: [id])
  createdBy        UserAccount?          @relation("ScheduleCreator", fields: [createdById], references: [id])
  participants     ScheduleParticipant[]
  sessions         ScheduleSession[]
  revisions        ScheduleRevision[]

  @@index([organizationId, status])
  @@map("training_schedules")
  trainingEvents TrainingEvent[]
}

/// مشاركو الجدول — ربط الجدول بمتدرب واحد أو مجموعة متدربين
model ScheduleParticipant {
  id               String           @id @default(uuid()) @db.Uuid
  scheduleId       String           @map("schedule_id") @db.Uuid
  traineeProfileId String           @map("trainee_profile_id") @db.Uuid
  joinedAt         DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)

  schedule         TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  traineeProfile   TraineeProfile   @relation(fields: [traineeProfileId], references: [id])

  @@unique([scheduleId, traineeProfileId])
  @@map("schedule_participants")
}

/// قالب الجداول والشيفتات — لإعادة الاستخدام في الأقسام
model ScheduleTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  departmentId   String?      @map("department_id") @db.Uuid
  nameAr         String       @map("name_ar") @db.VarChar(200)
  nameEn         String?      @map("name_en") @db.VarChar(200)
  structureJson  Json         @default("[]") @map("structure_json")
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])

  @@map("schedule_templates")
}

/// جلسة تدريبية فعليّة ضمن الجدول
model ScheduleSession {
  id               String           @id @default(uuid()) @db.Uuid
  scheduleId       String           @map("schedule_id") @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  departmentId     String           @map("department_id") @db.Uuid
  trainerProfileId String?          @map("trainer_profile_id") @db.Uuid
  traineeProfileId String?          @map("trainee_profile_id") @db.Uuid
  date             DateTime         @db.Date
  startTime        String           @map("start_time") @db.VarChar(10) // "08:00"
  endTime          String           @map("end_time") @db.VarChar(10)   // "16:00"
  durationHours    Decimal          @map("duration_hours") @db.Decimal(4, 2)
  sessionType      String           @default("clinical_round") @map("session_type") @db.VarChar(50) // clinical_round | emergency_shift | lecture | workshop | call
  shiftType        String           @default("morning") @map("shift_type") @db.VarChar(20) // morning | evening | night | 24h
  location         String?          @db.VarChar(200)
  capacity         Int              @default(1)
  status           String           @default("scheduled") @db.VarChar(20) // scheduled | completed | cancelled
  notes            String?

  schedule         TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id])
  department       Department       @relation(fields: [departmentId], references: [id])
  trainerProfile   TrainerProfile?  @relation(fields: [trainerProfileId], references: [id])
  traineeProfile   TraineeProfile?  @relation(fields: [traineeProfileId], references: [id])

  @@index([scheduleId])
  @@index([organizationId, date])
  @@index([trainerProfileId, date])
  @@index([traineeProfileId, date])
  @@map("schedule_sessions")
}

/// سجل تعديلات وإصدارات الجداول المنشورة — Version Snapshot
model ScheduleRevision {
  id            String           @id @default(uuid()) @db.Uuid
  scheduleId    String           @map("schedule_id") @db.Uuid
  revision      Int              @default(1)
  snapshot      Json             @map("snapshot")
  oldValues     Json?            @map("old_values")
  newValues     Json?            @map("new_values")
  changeReason  String?          @map("change_reason")
  publishedById String?          @map("published_by") @db.Uuid
  publishedAt   DateTime         @default(now()) @map("published_at") @db.Timestamptz(6)

  schedule      TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  publishedBy   UserAccount?     @relation(fields: [publishedById], references: [id])

  @@map("schedule_revisions")
}

/// فعالية تدريبية تشغيلية — طبقة موحّدة للنداءات والدورات والمحاضرات
/// والاجتماعات والمهام والإعلانات. تحل محل إنشاء نموذج لكل نوع.
///
/// ليست إسناداً ولا توزيعاً: الفعالية نشاط تشغيلي يجري *بعد* أن يحدّد
/// Assignment/Rotation من يتبع من. لا يجوز لأي فعالية أن تغيّر إسناداً أو
/// روتيشن أو تبعية مستشفى — العلاقات تُقرأ منها ولا تُكتب فيها.
///
/// TrainerCall يبقى كما هو (مدرب ← متدربوه) ولا تستبدله هذه الطبقة.
model TrainingEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  /// الجهة المالكة للفعالية — تُشتق من جلسة المنشئ، لا من الطلب.
  organizationId String                   @map("organization_id") @db.Uuid
  createdById    String                   @map("created_by") @db.Uuid
  /// urgent_call | training_course | lecture | training_session | video |
  /// meeting | task | announcement — نص وفق اصطلاح بقية المخطط لا enum.
  eventType      String                   @map("event_type") @db.VarChar(30)
  title          String                   @db.VarChar(200)
  description    String?
  priority       String                   @default("normal") @db.VarChar(20)
  /// information_only | acknowledge | accept_decline | attendance | arrival |
  /// completion — يحدّد الإجراءات المتاحة للمستلم.
  responseMode   String                   @map("response_mode") @db.VarChar(30)
  /// تعريف الجمهور كما اختاره المنشئ. يُحفظ للتدقيق فقط؛ المستلمون
  /// المحسوبون في TrainingEventRecipient هم المرجع الفعلي.
  audienceType   String                   @map("audience_type") @db.VarChar(30)
  /// روابط اختيارية بالسياق التدريبي. اختيارية بالضرورة: دورة يرسلها مدير
  /// التجمع لكل المدربين لا روتيشن لها ولا جدول. الفعالية تقرأ هذه العلاقات
  /// ولا تكتب فيها — لا تغيّر إسناداً ولا روتيشن ولا جدولاً.
  rotationId     String?                  @map("rotation_id") @db.Uuid
  scheduleId     String?                  @map("schedule_id") @db.Uuid
  /// مورد الفعالية (فيديو تدريبي مثلاً) من مخزن الملفات القائم — لا نظام جديد.
  resourceFileId String?                  @map("resource_file_id") @db.Uuid
  startAt        DateTime?                @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?                @map("end_at") @db.Timestamptz(6)
  /// draft | sent | completed | cancelled
  status         String                   @default("draft") @db.VarChar(20)
  sentAt         DateTime?                @map("sent_at") @db.Timestamptz(6)
  completedAt    DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  createdBy      UserAccount              @relation("TrainingEventCreator", fields: [createdById], references: [id])
  rotation       Rotation?                @relation(fields: [rotationId], references: [id])
  schedule       TrainingSchedule?        @relation(fields: [scheduleId], references: [id])
  resourceFile   StoredFile?              @relation(fields: [resourceFileId], references: [id])
  recipients     TrainingEventRecipient[]

  @@index([organizationId, status])
  @@index([createdById])
  @@map("training_events")
}

/// مستلم واحد لفعالية. الصف هو الإذن: لا يستطيع حساب التفاعل مع فعالية
/// ليس له صف فيها، فلا حاجة لإعادة فحص الجمهور عند كل استجابة.
model TrainingEventRecipient {
  id                 String          @id @default(uuid()) @db.Uuid
  eventId            String          @map("event_id") @db.Uuid
  recipientAccountId String          @map("recipient_account_id") @db.Uuid
  /// أي الملفين كان مصدر الاستحقاق وقت الحل — للتدقيق.
  trainerProfileId   String?         @map("trainer_profile_id") @db.Uuid
  traineeProfileId   String?         @map("trainee_profile_id") @db.Uuid
  /// pending | acknowledged | accepted | declined | attending | arrived |
  /// confirmed | completed
  status             String          @default("pending") @db.VarChar(20)
  acknowledgedAt     DateTime?       @map("acknowledged_at") @db.Timestamptz(6)
  acceptedAt         DateTime?       @map("accepted_at") @db.Timestamptz(6)
  declinedAt         DateTime?       @map("declined_at") @db.Timestamptz(6)
  attendedAt         DateTime?       @map("attended_at") @db.Timestamptz(6)
  /// إقرار ذاتي من المستلم — يقابله confirmedAt الذي يكتبه المخوَّل وحده.
  arrivedAt          DateTime?       @map("arrived_at") @db.Timestamptz(6)
  confirmedAt        DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  confirmedById      String?         @map("confirmed_by") @db.Uuid
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  event              TrainingEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientAccount   UserAccount     @relation("TrainingEventRecipientAccount", fields: [recipientAccountId], references: [id])
  confirmedBy        UserAccount?    @relation("TrainingEventConfirmer", fields: [confirmedById], references: [id])

  /// يمنع تكرار المستلم على مستوى قاعدة البيانات، فإعادة إرسال الطلب لا
  /// تنتج صفوفاً ولا إشعارات مكررة حتى لو أخطأ الكود.
  @@unique([eventId, recipientAccountId])
  @@index([recipientAccountId, status])
  @@map("training_event_recipients")
}
