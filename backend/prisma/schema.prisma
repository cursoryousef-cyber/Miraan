/// كتالوج البرامج التدريبية — مُدار مركزياً على مستوى الوطن
/// organizationId = NULL يعني برنامج مركزي في الكتالوج الوطني.
/// القيمة غير الفارغة محفوظة للبرامج القديمة المرتبطة بجهة (توافقية).
model Program {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String?           @map("organization_id") @db.Uuid
  nameAr             String            @map("name_ar") @db.VarChar(300)
  nameEn             String?           @map("name_en") @db.VarChar(300)
  code               String            @unique @db.VarChar(50)
  programType        String            @map("program_type") @db.VarChar(50)
  durationMonths     Int               @map("duration_months")
  description        String?
  requirements       Json              @default("{}")
  departmentSequence Json              @default("[]") @map("department_sequence")
  isActive           Boolean           @default(true) @map("is_active")
  createdById        String?           @map("created_by") @db.Uuid
  updatedById        String?           @map("updated_by") @db.Uuid
  deletedById        String?           @map("deleted_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  sortOrder          Int               @default(0) @map("sort_order")
  academicIntakes    AcademicIntake[]
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rotations          Rotation[]
  traineeProfiles    TraineeProfile[]
  qualifiedTrainers  TrainerProgram[]
  trainingPlans      TrainingPlan[]
  trainingRequests   TrainingRequest[]

  @@index([organizationId])
  @@map("programs")
}

/// قالب الخطة التدريبية — الهوية الثابتة للخطة.
/// لا يحمل محتوى تدريبياً بنفسه؛ المحتوى يعيش في الإصدارات (TrainingPlanVersion)
/// وهي غير قابلة للتعديل بعد الاعتماد. تعديل خطة معتمدة يُنشئ إصداراً جديداً.
model TrainingPlan {
  id               String                @id @default(uuid()) @db.Uuid
  programId        String                @map("program_id") @db.Uuid
  /// فارغ = قالب وطني مرتبط بالكتالوج المركزي. غير فارغ = خطة خاصة بجهة (إرث).
  organizationId   String?               @map("organization_id") @db.Uuid
  trainingYear     String?               @map("training_year") @db.VarChar(20)
  nameAr           String                @map("name_ar") @db.VarChar(200)
  nameEn           String?               @map("name_en") @db.VarChar(200)
  startDate        DateTime?             @map("start_date") @db.Date
  endDate          DateTime?             @map("end_date") @db.Date
  status           String                @default("draft") @db.VarChar(20)
  createdById      String?               @map("created_by") @db.Uuid
  updatedById      String?               @map("updated_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// رمز القالب داخل البرنامج — مستقر عبر الإصدارات
  code             String?               @db.VarChar(50)
  isActive         Boolean               @default(true) @map("is_active")
  traineeProfiles  TraineeProfile[]
  versions         TrainingPlanVersion[]
  createdBy        UserAccount?          @relation(fields: [createdById], references: [id])
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program          Program               @relation(fields: [programId], references: [id])
  trainingRequests TrainingRequest[]

  @@unique([programId, code])
  @@index([programId])
  @@map("training_plans")
}

/// إصدار خطة تدريبية — غير قابل للتعديل بعد الاعتماد (immutable).
/// المتدرب يبقى مرتبطاً بالإصدار الذي بدأ به، وتقارير الأداء التاريخية
/// ترجع دائماً إلى الإصدار الأصلي ولا يُعاد كتابتها أبداً.
model TrainingPlanVersion {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainingPlanId        String                 @map("training_plan_id") @db.Uuid
  versionNumber         Int                    @map("version_number")
  /// وصف الإصدار كما يظهر في التقارير — مثال: «الإصدار 1 (2026)»
  label                 String?                @db.VarChar(200)
  /// draft = قابل للتعديل | active = معتمد وغير قابل للتعديل | archived = تاريخي
  status                String                 @default("draft") @db.VarChar(20)
  effectiveFrom         DateTime?              @map("effective_from") @db.Date
  effectiveTo           DateTime?              @map("effective_to") @db.Date
  /// مدة الخطة بالأسابيع — محسوبة من مجموع مدد الروتيشنات
  totalWeeks            Int                    @default(0) @map("total_weeks")
  notes                 String?
  /// الإصدار الذي حلّ محل هذا الإصدار — يحفظ سلسلة النسب للتقارير
  supersededByVersionId String?                @map("superseded_by_version_id") @db.Uuid
  /// الإصدار الذي نُسخ عنه هذا الإصدار عند التعديل
  clonedFromVersionId   String?                @map("cloned_from_version_id") @db.Uuid
  publishedAt           DateTime?              @map("published_at") @db.Timestamptz(6)
  publishedById         String?                @map("published_by") @db.Uuid
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdById           String?                @map("created_by") @db.Uuid
  updatedById           String?                @map("updated_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  traineeProfiles       TraineeProfile[]
  rotations             TrainingPlanRotation[]
  clonedFrom            TrainingPlanVersion?   @relation("PlanVersionClone", fields: [clonedFromVersionId], references: [id])
  clones                TrainingPlanVersion[]  @relation("PlanVersionClone")
  supersededBy          TrainingPlanVersion?   @relation("PlanVersionSupersede", fields: [supersededByVersionId], references: [id])
  supersedes            TrainingPlanVersion[]  @relation("PlanVersionSupersede")
  trainingPlan          TrainingPlan           @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingRequests      TrainingRequest[]

  @@unique([trainingPlanId, versionNumber])
  @@index([trainingPlanId, status])
  @@map("training_plan_versions")
}

/// روتيشن ضمن قالب الخطة — ينتمي إلى إصدار محدد ولا يُعدَّل تاريخياً أبداً.
/// تعديل روتيشن في إصدار معتمد يُنشئ إصداراً جديداً بدل الكتابة فوق القديم.
model TrainingPlanRotation {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainingPlanVersionId String              @map("training_plan_version_id") @db.Uuid
  /// ترتيب الروتيشن داخل الخطة — يحدد التسلسل الزمني عند الإنشاء
  sequenceOrder         Int                 @map("sequence_order")
  /// القسم كرمز وليس كمفتاح خارجي: القوالب وطنية بينما الأقسام تخص كل مستشفى،
  /// فيُحل الرمز إلى قسم فعلي في المستشفى المخصص عند إنشاء جدول المتدرب.
  departmentCode        String              @map("department_code") @db.VarChar(50)
  departmentNameAr      String              @map("department_name_ar") @db.VarChar(200)
  departmentNameEn      String?             @map("department_name_en") @db.VarChar(200)
  specialtyCode         String?             @map("specialty_code") @db.VarChar(100)
  durationWeeks         Int                 @map("duration_weeks")
  isMandatory           Boolean             @default(true) @map("is_mandatory")
  /// المتطلبات محفوظة كلقطة (snapshot) وليست مفاتيح خارجية: الإصدار غير قابل
  /// للتعديل، فلا يجوز أن يتغير محتواه التاريخي إذا تغيّر الكتالوج لاحقاً.
  requiredCompetencies  Json                @default("[]") @map("required_competencies")
  /// [{ code, titleAr, minCount }] — تُحل إلى ProcedureCatalog لبذر CompetencyProgress
  requiredProcedures    Json                @default("[]") @map("required_procedures")
  requiredLogbookItems  Json                @default("[]") @map("required_logbook_items")
  /// [{ formType, titleAr, timing }] — تُحل إلى EvaluationForm الخاص بالمستشفى
  requiredEvaluations   Json                @default("[]") @map("required_evaluations")
  objectives            Json                @default("[]")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rotations             Rotation[]
  trainingPlanVersion   TrainingPlanVersion @relation(fields: [trainingPlanVersionId], references: [id], onDelete: Cascade)

  @@unique([trainingPlanVersionId, sequenceOrder], map: "training_plan_rotations_version_sequence_key")
  @@index([trainingPlanVersionId])
  @@map("training_plan_rotations")
}

/// الدفعات الأكاديمية — Academic Intake
model AcademicIntake {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  programId        String?           @map("program_id") @db.Uuid
  code             String            @unique @db.VarChar(50)
  nameAr           String            @map("name_ar") @db.VarChar(200)
  nameEn           String?           @map("name_en") @db.VarChar(200)
  academicYear     String            @map("academic_year") @db.VarChar(20)
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime          @map("end_date") @db.Date
  capacity         Int               @default(0)
  status           String            @default("planned") @db.VarChar(20)
  coordinatorId    String?           @map("coordinator_id") @db.Uuid
  notes            String?
  metadata         Json              @default("{}")
  createdById      String?           @map("created_by") @db.Uuid
  updatedById      String?           @map("updated_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// الطلب المعتمد الذي وُلدت منه هذه الدفعة. الدفعة الأكاديمية ليست كياناً
  /// مستقلاً — لا تُنشأ إلا من TrainingRequest بحالة approved، وهذا الحقل هو
  /// إثبات المصدر. يبقى nullable للدفعات التاريخية التي سبقت هذا القيد.
  trainingRequestId   String?        @unique @map("training_request_id") @db.Uuid
  /// الجامعة الموفدة — منسوخة من الطلب وقت الاعتماد لتظل الدفعة قابلة للقراءة
  /// دون الحاجة لتتبع الطلب في كل استعلام.
  universityOrgId     String?        @map("university_org_id") @db.Uuid
  approvedById        String?        @map("approved_by") @db.Uuid
  approvedAt          DateTime?      @map("approved_at") @db.Timestamptz(6)
  coordinator      UserAccount?      @relation("IntakeCoordinator", fields: [coordinatorId], references: [id])
  approvedBy       UserAccount?      @relation("IntakeApprover", fields: [approvedById], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  university       Organization?     @relation("IntakeUniversity", fields: [universityOrgId], references: [id])
  program          Program?          @relation(fields: [programId], references: [id])
  sourceRequest    TrainingRequest?  @relation("BatchSourceRequest", fields: [trainingRequestId], references: [id])
  traineeProfiles  TraineeProfile[]
  trainingRequests TrainingRequest[]
  traineeRows      TrainingRequestTrainee[]
  allocations      TraineeAllocation[]

  @@index([organizationId, academicYear])
  @@index([trainingRequestId])
  @@map("academic_intakes")
}

model TrainingRequest {
  id                     String                   @id @default(uuid()) @db.Uuid
  requestNumber          String                   @unique @map("request_number") @db.VarChar(50)
  sourceOrgId            String                   @map("source_org_id") @db.Uuid
  targetOrgId            String                   @map("target_org_id") @db.Uuid
  programId              String?                  @map("program_id") @db.Uuid
  academicIntakeId       String?                  @map("academic_intake_id") @db.Uuid
  studentCount           Int                      @default(0) @map("student_count")
  priority               String                   @default("normal") @db.VarChar(20)
  status                 String                   @default("submitted") @db.VarChar(50)
  notes                  String?
  allocations            Json                     @default("[]")
  createdById            String?                  @map("created_by") @db.Uuid
  updatedById            String?                  @map("updated_by") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// قالب الخطة التدريبية الذي اختارته الجامعة عند التقديم
  trainingPlanId         String?                  @map("training_plan_id") @db.Uuid
  /// الإصدار المثبّت وقت التقديم — يبقى ثابتاً حتى لو صدر إصدار أحدث لاحقاً
  trainingPlanVersionId  String?                  @map("training_plan_version_id") @db.Uuid
  trainingStartDate      DateTime?                @map("training_start_date") @db.Date
  trainingEndDate        DateTime?                @map("training_end_date") @db.Date
  expectedGraduationDate DateTime?                @map("expected_graduation_date") @db.Date
  /// رمز التخصص من LookupTable — تخصص الدفعة كاملة كما تحدده الجامعة.
  /// يبقى التخصص على مستوى الصف هو المرجع لكل متدرب على حدة.
  specialty              String?                  @db.VarChar(100)
  trainees               TrainingRequestTrainee[]
  /// الدفعة الأكاديمية الناتجة عن اعتماد هذا الطلب (1:1). تختلف عن
  /// academicIntake أدناه، وهي العلاقة القديمة التي تربط الطلب بدفعة/فترة
  /// قائمة مسبقاً — تلك تبقى للبيانات التاريخية.
  producedBatch          AcademicIntake?          @relation("BatchSourceRequest")
  traineeAllocations     TraineeAllocation[]
  academicIntake         AcademicIntake?          @relation(fields: [academicIntakeId], references: [id])
  program                Program?                 @relation(fields: [programId], references: [id])
  sourceOrg              Organization             @relation("TrainingReqSourceOrg", fields: [sourceOrgId], references: [id])
  targetOrg              Organization             @relation("TrainingReqTargetOrg", fields: [targetOrgId], references: [id])
  trainingPlan           TrainingPlan?            @relation(fields: [trainingPlanId], references: [id])
  trainingPlanVersion    TrainingPlanVersion?     @relation(fields: [trainingPlanVersionId], references: [id])

  @@index([sourceOrgId])
  @@index([targetOrgId])
  @@map("training_requests")
}

/// صف المتدرب داخل دفعة طلب التدريب — سجل مرشّح قابل للمراجعة والتعديل
/// والدمج والتقسيم والرفض قبل أن يتحول إلى حساب حقيقي (TraineeProfile).
/// الترقية إلى حساب فعلي تتم فقط عند بلوغ الحالة cluster_approved.
model TrainingRequestTrainee {
  id                          String                   @id @default(uuid()) @db.Uuid
  trainingRequestId           String                   @map("training_request_id") @db.Uuid
  personId                    String?                  @map("person_id") @db.Uuid
  traineeProfileId            String?                  @unique @map("trainee_profile_id") @db.Uuid
  academicNumber              String                   @map("academic_number") @db.VarChar(50)
  nationalId                  String                   @map("national_id") @db.VarChar(20)
  nameAr                      String                   @map("name_ar") @db.VarChar(200)
  nameEn                      String?                  @map("name_en") @db.VarChar(200)
  gender                      String?                  @db.VarChar(10)
  universityOrgId             String?                  @map("university_org_id") @db.Uuid
  collegeOrgId                String?                  @map("college_org_id") @db.Uuid
  internshipProgram           String?                  @map("internship_program") @db.VarChar(200)
  specialty                   String?                  @db.VarChar(200)
  gpa                         Decimal?                 @db.Decimal(4, 2)
  mobile                      String?                  @db.VarChar(20)
  email                       String?                  @db.VarChar(200)
  trainingPeriod              String?                  @map("training_period") @db.VarChar(50)
  startDate                   DateTime?                @map("start_date") @db.Date
  endDate                     DateTime?                @map("end_date") @db.Date
  priority                    String                   @default("normal") @db.VarChar(20)
  status                      String                   @default("draft") @db.VarChar(30)
  validationErrors            Json                     @default("[]") @map("validation_errors")
  clusterInternalNotes        String?                  @map("cluster_internal_notes")
  officialComments            String?                  @map("official_comments")
  returnReason                String?                  @map("return_reason")
  requiredDocuments           Json                     @default("[]") @map("required_documents")
  correctionDeadline          DateTime?                @map("correction_deadline") @db.Date
  assignedHospitalId          String?                  @map("assigned_hospital_id") @db.Uuid
  assignedDepartmentId        String?                  @map("assigned_department_id") @db.Uuid
  assignedTrainerProfileId    String?                  @map("assigned_trainer_profile_id") @db.Uuid
  assignedSupervisorAccountId String?                  @map("assigned_supervisor_account_id") @db.Uuid
  mergedIntoId                String?                  @map("merged_into_id") @db.Uuid
  splitFromId                 String?                  @map("split_from_id") @db.Uuid
  createdById                 String?                  @map("created_by") @db.Uuid
  updatedById                 String?                  @map("updated_by") @db.Uuid
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// الدفعة الأكاديمية التي ينتمي إليها هذا المتدرب. تُملأ عند اعتماد الطلب
