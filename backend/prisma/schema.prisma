  objectives              Objective[]
  orgAssignments          OrganizationAssignment[]
  rotations               Rotation[]
  shifts                  Shift[]
  trainerCalls            TrainerCall[]
  trainerProfiles         TrainerProfile[]
  trainerReassignments    TrainerReassignment[]
  trainingRequestTrainees TrainingRequestTrainee[]
  traineeAllocations      TraineeAllocation[]
  trainingSchedules       TrainingSchedule[]
  scheduleTemplates       ScheduleTemplate[]
