generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// أنواع الجهات — قابلة للتوسع بدون تعديل كود
model OrganizationType {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique @db.VarChar(50)
  nameAr            String         @map("name_ar") @db.VarChar(200)
  nameEn            String         @map("name_en") @db.VarChar(200)
  icon              String?        @db.VarChar(50)
  sortOrder         Int            @default(0) @map("sort_order")
  canHaveChildren   Boolean        @default(true) @map("can_have_children")
  allowedChildTypes String[]       @map("allowed_child_types")
  autoCreateRole    String?        @map("auto_create_role") @db.VarChar(100)
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations     Organization[]

  @@map("organization_types")
}

/// الجهات — شجرة تنظيمية ديناميكية بالكامل (لا جهة ثابتة في الكود)
/// Health Holding Company, Cluster, Hospital, University — كلها سجلات عادية
model Organization {
  id                                  String                    @id @default(uuid()) @db.Uuid
  organizationTypeId                  String                    @map("organization_type_id") @db.Uuid
  parentId                            String?                   @map("parent_id") @db.Uuid
  code                                String                    @unique @db.VarChar(50)
  nameAr                              String                    @map("name_ar") @db.VarChar(300)
  nameEn                              String                    @map("name_en") @db.VarChar(300)
  status                              String                    @default("draft") @db.VarChar(20)
  cityAr                              String?                   @map("city_ar") @db.VarChar(100)
  cityEn                              String?                   @map("city_en") @db.VarChar(100)
  regionAr                            String?                   @map("region_ar") @db.VarChar(100)
  regionEn                            String?                   @map("region_en") @db.VarChar(100)
  logoUrl                             String?                   @map("logo_url") @db.VarChar(500)
  contactEmail                        String?                   @map("contact_email") @db.VarChar(200)
  contactPhone                        String?                   @map("contact_phone") @db.VarChar(20)
  website                             String?                   @db.VarChar(300)
  address                             String?
  settings                            Json                      @default("{}")
  trainingYear                        String?                   @map("training_year") @db.VarChar(20)
  defaultLanguage                     String                    @default("ar") @map("default_language") @db.VarChar(5)
  createdById                         String?                   @map("created_by") @db.Uuid
  updatedById                         String?                   @map("updated_by") @db.Uuid
  deletedById                         String?                   @map("deleted_by") @db.Uuid
  createdAt                           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                           DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  /// @deprecated لم يعد يُقرأ في أي حساب للطاقة الاستيعابية. مصدر الحقيقة الوحيد
  /// لسعة المستشفى التدريبية هو مجموع سعات أقسامه المفعّلة
  /// (SUM(departments.capacity) WHERE is_active). العمود باقٍ للتوافق التاريخي
  /// فقط — كان رقماً ثانياً يُحرَّر باستقلال عن الأقسام فتتناقض الشاشات.
  capacity                            Int                       @default(0)
  geoLat                              Decimal?                  @map("geo_lat") @db.Decimal(10, 7)
  geoLng                              Decimal?                  @map("geo_lng") @db.Decimal(10, 7)
  academicIntakes                     AcademicIntake[]
  attendanceRecords                   Attendance[]
  auditLogs                           AuditLog[]
  capacityAllocations                 CapacityAllocation[]
  caseLogs                            ClinicalCaseLog[]
  clinicalPrivileges                  ClinicalPrivilege[]
  dashboardSnapshots                  DashboardSnapshot[]
  declarationAcceptances              DeclarationAcceptance[]
  declarations                        Declaration[]
  departments                         Department[]
  documents                           Document[]
  evaluationForms                     EvaluationForm[]
  evaluations                         Evaluation[]
  featureFlags                        FeatureFlag[]
  generatedReports                    GeneratedReport[]
  improvementPlans                    ImprovementPlan[]
  incidents                           Incident[]
  targetIncidents                     Incident[]                @relation("IncidentTargetOrg")
  integrationConfigs                  IntegrationConfig[]
  notifications                       Notification[]
  objectives                          Objective[]
  allocationsAsCluster                TraineeAllocation[]       @relation("AllocationCluster")
  allocationsAsHospital               TraineeAllocation[]       @relation("AllocationHospital")
  sponsoredIntakes                    AcademicIntake[]          @relation("IntakeUniversity")
  affiliationsAsSource                OrganizationAffiliation[] @relation("AffiliationSource")
  affiliationsAsTarget                OrganizationAffiliation[] @relation("AffiliationTarget")
  orgAssignments                      OrganizationAssignment[]
  descendants                         OrganizationHierarchy[]   @relation("HierarchyAncestor")
  ancestors                           OrganizationHierarchy[]   @relation("HierarchyDescendant")
  license                             OrganizationLicense?
  organizationType                    OrganizationType          @relation(fields: [organizationTypeId], references: [id])
  parent                              Organization?             @relation("OrgHierarchy", fields: [parentId], references: [id])
  children                            Organization[]            @relation("OrgHierarchy")
  outboxEvents                        OutboxEvent[]
  policies                            Policy[]
  programs                            Program[]
  reportDefinitions                   ReportDefinition[]
  rotations                           Rotation[]
  orgSettings                         Setting[]                 @relation("OrgSettings")
  shifts                              Shift[]
  storedFiles                         StoredFile[]
  tasks                               Task[]
  traineeProfiles                     TraineeProfile[]
  sponsoredTrainees                   TraineeProfile[]          @relation("SponsorOrg")
  trainerCalls                        TrainerCall[]
  trainingEvents                      TrainingEvent[]
  trainerLeaves                       TrainerLeave[]
  trainerProfiles                     TrainerProfile[]
  trainerReassignments                TrainerReassignment[]
  trainingPlans                       TrainingPlan[]
  trainingRequestTraineesAsHospital   TrainingRequestTrainee[]  @relation("TRTHospital")
  trainingRequestTraineesAsCollege    TrainingRequestTrainee[]  @relation("TRTCollege")
  trainingRequestTraineesAsUniversity TrainingRequestTrainee[]  @relation("TRTUniversity")
  trainingReqsSent                    TrainingRequest[]         @relation("TrainingReqSourceOrg")
  trainingReqsReceived                TrainingRequest[]         @relation("TrainingReqTargetOrg")
  userOrganizations                   UserOrganization[]
  userPermissions                     UserPermission[]
  userRoles                           UserRole[]
  webhookSubscriptions                WebhookSubscription[]
  workflowDefinitions                 WorkflowDefinition[]
  workflowInstances                   WorkflowInstance[]
  trainingSchedules                   TrainingSchedule[]
  scheduleTemplates                   ScheduleTemplate[]
  scheduleSessions                    ScheduleSession[]

  @@index([parentId])
  @@index([organizationTypeId])
  @@index([status])
  @@map("organizations")
}

/// Closure Table — O(1) ancestor/descendant queries
model OrganizationHierarchy {
  ancestorId   String       @map("ancestor_id") @db.Uuid
  descendantId String       @map("descendant_id") @db.Uuid
  depth        Int          @default(0)
  ancestor     Organization @relation("HierarchyAncestor", fields: [ancestorId], references: [id])
  descendant   Organization @relation("HierarchyDescendant", fields: [descendantId], references: [id])

  @@id([ancestorId, descendantId])
  @@map("organization_hierarchy")
}

/// اتفاقيات بين الجهات — جامعة ↔ مستشفى، تجمع ↔ مركز تدريب
model OrganizationAffiliation {
  id              String       @id @default(uuid()) @db.Uuid
  sourceOrgId     String       @map("source_org_id") @db.Uuid
  targetOrgId     String       @map("target_org_id") @db.Uuid
  affiliationType String       @map("affiliation_type") @db.VarChar(50)
  nameAr          String?      @map("name_ar") @db.VarChar(300)
  nameEn          String?      @map("name_en") @db.VarChar(300)
  agreementRef    String?      @map("agreement_ref") @db.VarChar(100)
  startDate       DateTime?    @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  status          String       @default("active") @db.VarChar(20)
  notes           String?
  metadata        Json         @default("{}")
  createdById     String?      @map("created_by") @db.Uuid
  updatedById     String?      @map("updated_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceOrg       Organization @relation("AffiliationSource", fields: [sourceOrgId], references: [id])
  targetOrg       Organization @relation("AffiliationTarget", fields: [targetOrgId], references: [id])

  @@unique([sourceOrgId, targetOrgId, affiliationType])
  @@map("organization_affiliations")
}

/// Feature Flags — تشغيل/إيقاف ميزات لكل جهة
model FeatureFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  featureCode    String       @map("feature_code") @db.VarChar(100)
  isEnabled      Boolean      @default(false) @map("is_enabled")
  configuration  Json         @default("{}")
  enabledAt      DateTime?    @map("enabled_at") @db.Timestamptz(6)
  disabledAt     DateTime?    @map("disabled_at") @db.Timestamptz(6)
  updatedById    String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureCode])
  @@map("feature_flags")
}

/// رخص الجهات — نموذج اشتراك / ترخيص
model OrganizationLicense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  plan           String       @default("basic") @db.VarChar(50)
  maxUsers       Int          @default(50) @map("max_users")
  maxTrainees    Int          @default(200) @map("max_trainees")
  maxStorageGb   Int          @default(10) @map("max_storage_gb")
  features       String[]     @default([])
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         String       @default("active") @db.VarChar(20)
  autoRenew      Boolean      @default(false) @map("auto_renew")
  notes          String?
  createdById    String?      @map("created_by") @db.Uuid
  updatedById    String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_licenses")
}

/// الشخص — الهوية الفعلية (مستقلة عن حسابات الدخول)
model Person {
  id                    String                   @id @default(uuid()) @db.Uuid
  nationalId            String?                  @unique @map("national_id") @db.VarChar(20)
  nameAr                String                   @map("name_ar") @db.VarChar(200)
  nameEn                String?                  @map("name_en") @db.VarChar(200)
  dateOfBirth           DateTime?                @map("date_of_birth") @db.Date
  gender                String?                  @db.VarChar(10)
  nationality           String?                  @db.VarChar(50)
  phone                 String?                  @db.VarChar(20)
  email                 String?                  @db.VarChar(200)
  avatarUrl             String?                  @map("avatar_url") @db.VarChar(500)
  bloodType             String?                  @map("blood_type") @db.VarChar(5)
  emergencyContactName  String?                  @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?                  @map("emergency_contact_phone") @db.VarChar(20)
  isActive              Boolean                  @default(true) @map("is_active")
  createdById           String?                  @map("created_by") @db.Uuid
  updatedById           String?                  @map("updated_by") @db.Uuid
  deletedById           String?                  @map("deleted_by") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                @map("deleted_at") @db.Timestamptz(6)
  traineeProfile        TraineeProfile?
  trainerProfile        TrainerProfile?
  trainingRequestRows   TrainingRequestTrainee[]
  userAccounts          UserAccount[]

  @@index([nationalId])
  @@map("persons")
}

/// حساب الدخول — شخص واحد يمكنه امتلاك عدة حسابات
model UserAccount {
  id                     String                   @id @default(uuid()) @db.Uuid
  personId               String                   @map("person_id") @db.Uuid
  username               String?                  @unique @db.VarChar(100)
  email                  String                   @unique @db.VarChar(200)
  passwordHash           String                   @map("password_hash") @db.VarChar(300)
  isEmailVerified        Boolean                  @default(false) @map("is_email_verified")
  isPhoneVerified        Boolean                  @default(false) @map("is_phone_verified")
  isActive               Boolean                  @default(true) @map("is_active")
  mfaEnabled             Boolean                  @default(false) @map("mfa_enabled")
  mfaSecret              String?                  @map("mfa_secret") @db.VarChar(200)
  lastLoginAt            DateTime?                @map("last_login_at") @db.Timestamptz(6)
  loginAttempts          Int                      @default(0) @map("login_attempts")
  lockedUntil            DateTime?                @map("locked_until") @db.Timestamptz(6)
  refreshTokenHash       String?                  @map("refresh_token_hash") @db.VarChar(300)
  activationToken        String?                  @map("activation_token") @db.VarChar(300)
  activationTokenExpiresAt DateTime?              @map("activation_token_expires_at") @db.Timestamptz(6)
  activatedAt            DateTime?                @map("activated_at") @db.Timestamptz(6)
  createdById            String?                  @map("created_by") @db.Uuid
  updatedById            String?                  @map("updated_by") @db.Uuid
  deletedById            String?                  @map("deleted_by") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz(6)
  intakeCoordinated      AcademicIntake[]         @relation("IntakeCoordinator")
  attendanceApproved     Attendance[]             @relation("AttendanceApprover")
  auditLogs              AuditLog[]
  declarationAcceptances DeclarationAcceptance[]
  documentsReviewed      Document[]               @relation("DocumentReviewer")
  documentsOwned         Document[]               @relation("DocumentOwner")
  evaluationsReceived    Evaluation[]             @relation("Evaluatee")
  evaluationsGiven       Evaluation[]             @relation("Evaluator")
  reportsGenerated       GeneratedReport[]        @relation("ReportGenerator")
  graduationApprovals    GraduationApproval[]     @relation("GraduationApprover")
  improvementCreated     ImprovementPlan[]        @relation("PlanCreator")
  improvementSupervised  ImprovementPlan[]        @relation("PlanSupervisor")
  incidentsReported      Incident[]               @relation("IncidentReporter")
  incidentsAssigned      Incident[]               @relation("IncidentAssignee")
  incidentsResolved      Incident[]               @relation("IncidentResolver")
  incidentComments       IncidentComment[]
  logbookSignoffs        LogbookSignoff[]
  notifications          Notification[]
  objectivesVerified     ObjectiveProgress[]      @relation("ObjectiveVerifier")
  orgAssignments         OrganizationAssignment[]
  trainingEventsCreated  TrainingEvent[]          @relation("TrainingEventCreator")
  trainingEventsReceived TrainingEventRecipient[] @relation("TrainingEventRecipientAccount")
  trainingEventsConfirmed TrainingEventRecipient[] @relation("TrainingEventConfirmer")
  supervisedRotations    Rotation[]               @relation("RotationSupervisor")
  settingsUpdated        Setting[]
  filesUploaded          StoredFile[]
  tasksCreated           Task[]                   @relation("TaskCreator")
  tasksAssigned          Task[]                   @relation("TaskAssignee")
  traineeCardIssued      TraineeProfile[]         @relation("CardIssuer")
  traineePhotoApproved   TraineeProfile[]         @relation("PhotoApprover")
  trainingPlansCreated   TrainingPlan[]
  createdSchedules       TrainingSchedule[]     @relation("ScheduleCreator")
  publishedRevisions     ScheduleRevision[]
  createdBy              UserAccount?             @relation("AccountCreator", fields: [createdById], references: [id])
  createdAccounts        UserAccount[]            @relation("AccountCreator")
  approvedIntakes        AcademicIntake[]         @relation("IntakeApprover")
  performedAllocations   TraineeAllocation[]      @relation("AllocationPerformer")
  person                 Person                   @relation(fields: [personId], references: [id])
  organizations          UserOrganization[]
  userPermissions        UserPermission[]
  userRoles              UserRole[]
  workflowActions        WorkflowAction[]

  @@index([personId])
  @@map("user_accounts")
}

/// عضوية المستخدم في الجهات — multi-org (legacy compatibility layer — read-only after migration)
model UserOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  userAccountId  String       @map("user_account_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  isPrimary      Boolean      @default(false) @map("is_primary")
  isActive       Boolean      @default(true) @map("is_active")
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?    @map("left_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@unique([userAccountId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

/// تعيينات المستخدمين في الجهات — نموذج التعيين المستقبلي
/// يدعم التعيينات المتعددة، السجل التاريخي الكامل، الإعارة المؤقتة، تعدد الجهات
model OrganizationAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  userAccountId  String       @map("user_account_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  departmentId   String?      @map("department_id") @db.Uuid
  roleId         String?      @map("role_id") @db.Uuid
  /// permanent | temporary | acting | rotation
  assignmentType String       @default("permanent") @map("assignment_type") @db.VarChar(20)
  isPrimary      Boolean      @default(false) @map("is_primary")
  isActive       Boolean      @default(true) @map("is_active")
  startDate      DateTime     @default(now()) @map("start_date") @db.Timestamptz(6)
  endDate        DateTime?    @map("end_date") @db.Timestamptz(6)
  reason         String?
  notes          String?
  /// source of truth for backfilled rows: user_organization | trainer_profile | trainee_profile | manual
  sourceType     String       @default("manual") @map("source_type") @db.VarChar(30)
  sourceId       String?      @map("source_id") @db.Uuid
  createdById    String?      @map("created_by") @db.Uuid
  updatedById    String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  department     Department?  @relation(fields: [departmentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role?        @relation(fields: [roleId], references: [id])
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId, isActive])
  @@index([organizationId, isActive])
  @@index([userAccountId, organizationId])
  @@map("organization_assignments")
}

model Role {
  id              String                   @id @default(uuid()) @db.Uuid
  code            String                   @unique @db.VarChar(100)
  nameAr          String                   @map("name_ar") @db.VarChar(200)
  nameEn          String                   @map("name_en") @db.VarChar(200)
  descriptionAr   String?                  @map("description_ar")
  descriptionEn   String?                  @map("description_en")
  hierarchyLevel  Int                      @default(0) @map("hierarchy_level")
  isSystem        Boolean                  @default(false) @map("is_system")
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  orgAssignments  OrganizationAssignment[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  nameAr          String           @map("name_ar") @db.VarChar(200)
  nameEn          String           @map("name_en") @db.VarChar(200)
  module          String           @db.VarChar(100)
  descriptionAr   String?          @map("description_ar")
  descriptionEn   String?          @map("description_en")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Multi-org + multi-role: user can have different roles in different organizations
model UserRole {
  userAccountId  String       @map("user_account_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  assignedAt     DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById   String?      @map("assigned_by") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@id([userAccountId, roleId, organizationId])
  @@map("user_roles")
}

model UserPermission {
  userAccountId  String       @map("user_account_id") @db.Uuid
  permissionId   String       @map("permission_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  granted        Boolean      @default(true)
  grantedAt      DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById    String?      @map("granted_by") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@id([userAccountId, permissionId, organizationId])
  @@map("user_permissions")
}

/// Policy Engine (ABAC) — conditions evaluated at runtime
model Policy {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  code           String        @unique @db.VarChar(100)
  nameAr         String        @map("name_ar") @db.VarChar(200)
  nameEn         String        @map("name_en") @db.VarChar(200)
  description    String?
  resource       String        @db.VarChar(100)
  action         String        @db.VarChar(50)
  effect         String        @default("allow") @db.VarChar(10)
  conditions     Json          @default("{}")
  priority       Int           @default(0)
  isActive       Boolean       @default(true) @map("is_active")
  createdById    String?       @map("created_by") @db.Uuid
  updatedById    String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([resource, action])
  @@map("policies")
}

model WorkflowDefinition {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  code           String             @unique @db.VarChar(100)
  nameAr         String             @map("name_ar") @db.VarChar(200)
  nameEn         String             @map("name_en") @db.VarChar(200)
  description    String?
  entityType     String             @map("entity_type") @db.VarChar(100)
  version        Int                @default(1)
  steps          Json               @default("[]")
  transitions    Json               @default("[]")
  isActive       Boolean            @default(true) @map("is_active")
  createdById    String?            @map("created_by") @db.Uuid
  updatedById    String?            @map("updated_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  instances      WorkflowInstance[]

  @@index([entityType])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  workflowDefinitionId String             @map("workflow_definition_id") @db.Uuid
  entityType           String             @map("entity_type") @db.VarChar(100)
  entityId             String             @map("entity_id") @db.Uuid
  currentStep          String             @map("current_step") @db.VarChar(100)
  status               String             @default("in_progress") @db.VarChar(20)
  metadata             Json               @default("{}")
  startedAt            DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  actions              WorkflowAction[]
  organization         Organization       @relation(fields: [organizationId], references: [id])
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId, status])
  @@map("workflow_instances")
}

model WorkflowAction {
  id                 String           @id @default(uuid()) @db.Uuid
  workflowInstanceId String           @map("workflow_instance_id") @db.Uuid
  fromStep           String           @map("from_step") @db.VarChar(100)
  toStep             String           @map("to_step") @db.VarChar(100)
  action             String           @db.VarChar(50)
  performedById      String?          @map("performed_by") @db.Uuid
  comment            String?
  metadata           Json             @default("{}")
  performedAt        DateTime         @default(now()) @map("performed_at") @db.Timestamptz(6)
  performedBy        UserAccount?     @relation(fields: [performedById], references: [id])
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId])
  @@map("workflow_actions")
}

/// Transactional Outbox — guarantees events are published exactly once
model OutboxEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(100)
  aggregateType  String        @map("aggregate_type") @db.VarChar(100)
  aggregateId    String        @map("aggregate_id") @db.Uuid
  payload        Json
  status         String        @default("pending") @db.VarChar(20)
  retryCount     Int           @default(0) @map("retry_count")
  maxRetries     Int           @default(5) @map("max_retries")
  lastError      String?       @map("last_error")
  scheduledAt    DateTime      @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, scheduledAt])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Department {
